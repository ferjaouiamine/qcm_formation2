{
  "name": "qcm-formation-assurance-vie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "dev:full": "vite",
    "import:questions": "python scripts/import_questionnaire.py",
    "setup:local": "tsx scripts/setup-local.ts && npm run db:migrate && npm run db:seed",
    "verify:import": "python scripts/import_questionnaire.py --check",
    "test:e2e": "playwright test",
    "format": "prettier --write src server api db scripts tests *.ts *.json *.html *.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@tanstack/react-query": "^5.83.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "jose": "^6.0.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.7.1",
    "recharts": "^3.1.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^5.3.5",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
